<?php

$data = $result_data->data;

    $result_prosecution = [];
    foreach ($result_data->data as $row) {
        $result_prosecution[] = $row->Fiscalia;
    }

    $result_ref3 = array_filter($result_prosecution, function($row){
        return $row->Especialidad == 'PENAL';
    });

    $result_ref4 = array_filter($result_prosecution, function($row){
        return $row->Especialidad == 'CIVIL';
    });

    $result_ref5 = array_filter($result_prosecution, function($row){
        return $row->Especialidad == 'FAMILIA';
    });
?>
